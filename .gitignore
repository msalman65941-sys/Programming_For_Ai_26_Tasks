# Ignore everything in the project root
/*

# Allow Git configuration
!/.gitignore

# Allow weekly labs (week01, week02, week03...)
!/week[0-9][0-9]/

# Ignore environments and temporary files
.venv/
venv/
env/
environment/
.vs/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Ignore private files
.env
.env.*